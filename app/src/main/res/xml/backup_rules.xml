<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 8-11 (API 26-30). These versions can't tell cloud backup apart from
    device transfer reliably, so nothing is backed up at all: privacy wins over
    convenience. Android 12+ uses data_extraction_rules.xml instead.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
